# Copy to .env and fill in. Never commit .env.

# Postgres connection string (Neon, RDS, or local).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Integration tests only. The test setup EMPTIES this database/schema, so it must
# not be your real one. Same database with its own schema is fine:
TEST_DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require&schema=test"

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Public origin used by the browser auth client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: enables the "Try the demo" button on the landing page.
# Create the account first with `npm run seed:demo` (same values).
DEMO_EMAIL=""
DEMO_PASSWORD=""

# Password-reset emails, sent through Gmail. Use an App Password (Google
# Account → Security → 2-Step Verification → App passwords), not your normal one.
# Without these, local dev prints the email to the terminal instead.
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
